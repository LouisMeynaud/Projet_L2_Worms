<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">

    <!--  Line Length  -->
    <module name="LineLength">
        <property name="max" value="180"/>
    </module>

    <module name="TreeWalker">


        <!-- Name rules -->
        <!-- Class Name : PascalCase -->
        <module name="TypeName"/>
        <!-- MethodName : camelCase -->
        <module name="MethodName"/>
        <!--  VariableName : camelCase -->
        <module name="LocalVariableName"/>
        <!--  Attributes Class : camelCase -->
        <module name="MemberName"/>

        <!--  Format Rules -->
        <!--  No empty Block in if or whatever -->
        <module name="EmptyBlock"/>
        <!--  Remove unnecessary {} -->
        <module name="AvoidNestedBlocks"/>
        <module name="AvoidDoubleBraceInitialization"/>
        <!-- all default case in switch will be last -->
        <module name="DefaultComesLast"/>
        <!-- Each file need a package declaration  -->
        <module name="PackageDeclaration"/>
        <!-- The indentation need to respect a format  -->
        <module name="Indentation"/>
        <!-- The close bracket need to respect this format  -->
        <module name="RightCurly">
            <property name="option" value="alone_or_singleline"/>
            <property name="tokens" value="METHOD_DEF,LITERAL_ELSE,ENUM_DEF,INTERFACE_DEF"/>
        </module>




        <!-- Import Rules -->
        <module name="UnusedImports"/>

        <!--  JavaDoc Rules - Add later
        <module name="JavadocType"/>
        <module name="JavadocMethod"/>
    -->

    </module>
</module>
